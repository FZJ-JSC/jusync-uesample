# Git LFS tracking for UE content — everything under any Content/ dir
Content/**           filter=lfs diff=lfs merge=lfs -text
**/Content/**        filter=lfs diff=lfs merge=lfs -text

# Explicit safety net (binary assets staged outside Content/)
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text
*.udatasmith filter=lfs diff=lfs merge=lfs -text
*.umdl   filter=lfs diff=lfs merge=lfs -text

# USD (JUSYNC pipeline assets)
*.usd  filter=lfs diff=lfs merge=lfs -text
